# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase example:
#   DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true) — the app.
#   DIRECT_URL   = session connection used by Prisma migrations. Use the
#                  direct host, or the session pooler on port 5432 if the
#                  direct host is IPv6-only / does not resolve.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of this app (used for cookies, callbacks and metadataBase).
# It MUST match the origin you open in the browser: Better Auth derives the
# OAuth `redirect_uri` from this value, so a port mismatch sends Google back to
# an address nothing is listening on ("page can't be reached"). `npm run dev`
# pins port 3000 and checks this value before starting.
BETTER_AUTH_URL="http://localhost:3000"
# Optional: extra comma-separated origins allowed to call the auth API
TRUSTED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth (optional — email/password sign-in works without it)
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client:
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
# The redirect URI must match exactly — no trailing slash, no wildcard, and no
# second port left over from debugging.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Cloudinary (listing image uploads)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Supabase client keys (optional, reserved for future storage/realtime work)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Read-only demo mode (Phase 6)
# ---------------------------------------------------------------------------
# When DEMO_MODE is true, accounts flagged isDemo (or listed below) can open
# every screen but no mutation will go through.
DEMO_MODE="false"
DEMO_ACCOUNT_EMAILS="demo-admin@alara.ng,demo-agent@alara.ng,demo-buyer@alara.ng"
# Shared secret for POST /api/demo/reset (nightly cron). Leave empty to disable.
DEMO_RESET_SECRET=""
